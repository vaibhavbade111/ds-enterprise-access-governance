        <script><![CDATA[// Query pending approvals for Access Requests older than 2 days
var apprGr = new GlideRecord('sysapproval_approver');
apprGr.addQuery('state', 'requested');
apprGr.addQuery('sysapproval.sys_class_name', 'x_2098628_ds_ent_0_access_request');
apprGr.addQuery('sys_created_on', '<=', gs.daysAgo(2));
apprGr.query();

while (apprGr.next()) {
    // Fire event passing approver sys_id in parm1
    gs.eventQueue('x_2098628_ds_ent_0.approval.reminder', apprGr, apprGr.getValue('approver'), '');
}]]></script>
