        <script><![CDATA[// Query all active access records where the expiration date has passed
var accessGr = new GlideRecord('x_2098628_ds_ent_0_access_inventory');
accessGr.addQuery('state', 'active');
accessGr.addQuery('expiration_date', '<=', gs.daysAgo(0));
accessGr.query();

while (accessGr.next()) {
    // Automatically transition the record state to Revoked
    accessGr.setValue('state', 'revoked');
    accessGr.comments = 'Access automatically revoked due to expiration policy.';
    accessGr.update();
}]]></script>
